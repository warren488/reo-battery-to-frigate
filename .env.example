# FTP server settings — used by Reolink cameras to upload clips.
#
# FTP_PUBLIC_HOST: the LAN IP of the machine running this stack (the address
# your cameras can reach). Required for FTP passive mode to work.
FTP_PUBLIC_HOST=192.168.1.100

# FTP credentials — CHANGE THESE. FTP sends credentials in cleartext, so only
# run this on a trusted network (see the Security notes in the README).
FTP_USER=reolink
FTP_PASS=reolink
